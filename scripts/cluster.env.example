# scripts/cluster.env.example — site config for the cluster wrappers.
#
# Copy to scripts/cluster.env (gitignored) and fill in the blanks, then open the
# master socket once per cluster you'll use (see scripts/open_master.sh).
#
# THREE backends (vast added 2026-07-10): ferranti (H100s, SLURM) and galvani
# (A100s, SLURM) use the submit_job.sh/job_status.sh/wait_for_jobs.sh/fetch_logs.sh/
# cancel_job.sh verbs. vast (rented GPU box, NO scheduler) uses the vast_run.sh/
# vast_status.sh/vast_wait.sh/vast_cancel.sh verbs instead — see scripts/README.md
# for which verb family applies to which backend. sync_code.sh/pull_results.sh/
# pull_file.sh are scheduler-agnostic (pure git/rsync) and work for all three.
# There is NO default — every wrapper requires --cluster {ferranti|galvani|vast}.
# Each cluster has its own stanza below; vars are prefixed FERRANTI_ / GALVANI_ /
# VAST_. _common.sh maps the chosen prefix onto generic vars (HOST, REMOTE_PATH, ...).
#
# Anything left blank that a wrapper needs → that wrapper exits with ERROR: BAD_CONFIG
# naming the missing key (never silently guesses).
#
# This file is SOURCED as shell — QUOTE any value containing spaces, e.g. a module
# list:  FERRANTI_MODULES="cuda/12.1 python/3.11"   (unquoted spaces break sourcing).

# ---------------------------------------------------------------------------
# GLOBAL
# ---------------------------------------------------------------------------
# W&B auth on the compute node. Either set this (exported into the job env by the
# sbatch template) OR leave blank and rely on a ~/.netrc on the remote. Secret —
# this file is gitignored.
WANDB_API_KEY=
# W&B entity (used by training scripts' --wandb-entity default if you pass it through).
WANDB_ENTITY=models-eberhard-karls-universit-t-t-bingen

# ---------------------------------------------------------------------------
# FERRANTI  (H100s) — was "MLCloud" in W&B metadata (mlcbm* hosts)
# ---------------------------------------------------------------------------
FERRANTI_SSH_HOST=                       # login hostname (e.g. ferranti.<domain>)
FERRANTI_SSH_USER=mot936
FERRANTI_PROXY_JUMP=                      # optional ProxyJump (user@gateway), blank if direct
FERRANTI_CONTROL_PATH=~/.ssh/cm-ferranti-%r@%h:%p   # ControlMaster socket (must match open_master.sh)
FERRANTI_REMOTE_PATH=/weka/martius/mot936/dreamerv4-tests   # remote git clone (from W&B metadata)
FERRANTI_PARTITION=                      # SLURM partition (e.g. h100)
FERRANTI_ACCOUNT=                        # SLURM account/QOS, blank if none
FERRANTI_GRES=gpu:1                      # --gres; submit_job --gpus N overrides the count
FERRANTI_CONSTRAINT=                     # optional --constraint (e.g. h100), blank if none
FERRANTI_DEFAULT_HOURS=8                 # default wall time; submit_job --hours H overrides
FERRANTI_MODULES=                        # optional 'module load' targets, space-separated; blank = pure venv
FERRANTI_VENV_ROOT=/weka/martius/mot936/venvs       # cached venvs (keyed on requirements.txt hash)
FERRANTI_RUNS_SUBDIR=runs                # results/logs under $REMOTE_PATH/$RUNS_SUBDIR/<run>

# ---------------------------------------------------------------------------
# GALVANI  (A100s) — galvani-cn* hosts in W&B metadata
# ---------------------------------------------------------------------------
GALVANI_SSH_HOST=                       # login hostname (e.g. galvani.<domain>)
GALVANI_SSH_USER=mot936
GALVANI_PROXY_JUMP=
GALVANI_CONTROL_PATH=~/.ssh/cm-galvani-%r@%h:%p
GALVANI_REMOTE_PATH=/mnt/lustre/work/martius/mot936/dreamerv4-tests
GALVANI_PARTITION=                      # e.g. a100-galvani
GALVANI_ACCOUNT=
GALVANI_GRES=gpu:1
GALVANI_CONSTRAINT=
GALVANI_DEFAULT_HOURS=12
GALVANI_MODULES=
GALVANI_VENV_ROOT=/mnt/lustre/work/martius/mot936/venvs
GALVANI_RUNS_SUBDIR=runs

# ---------------------------------------------------------------------------
# VAST  (rented GPU box, e.g. RTX 5090) — NO scheduler, single box, key-only auth
# ---------------------------------------------------------------------------
# No 2FA here (plain SSH key) — the agent MAY run open_master.sh --cluster vast
# itself and self-heal AUTH_DEAD without escalating (unlike ferranti/galvani).
# Still run vast_*.sh verbs in WSL, same as ferranti/galvani (scripts/README.md) —
# two concrete reasons, not just consistency: (1) pull_results.sh/pull_file.sh need
# rsync, which plain Windows Git Bash doesn't have; (2) VAST_SSH_KEY below MUST be a
# copy living in WSL's own native ~/.ssh/ (NOT /mnt/c/...) — WSL's drvfs mount can't
# hold real Unix permissions (chmod 600 silently doesn't stick), and ssh flatly
# refuses a world-readable private key. Generating the key in Git Bash is fine; just
# also copy it into WSL's native home before first use there.
# IMPORTANT: check `vast-capabilities | jq '.instance.workspace_is_volume'` on
# the box — if false (the common case), the container disk (incl. this venv
# and REMOTE_PATH clone) is wiped on recycle/destroy, NOT on stop/start. Always
# `stop` the instance between sessions (halts GPU billing, keeps the disk);
# only `destroy`/`recycle` loses everything, requiring VAST_REMOTE_PATH to be
# re-cloned and the venv rebuilt.
VAST_SSH_HOST=                           # public IP from the instance's Connect panel (prefer direct over the ssh*.vast.ai proxy)
VAST_SSH_PORT=                           # non-standard port from the same panel — CAN change if the instance is stopped/started; verify before assuming a stale value
VAST_SSH_USER=root
VAST_SSH_KEY=~/.ssh/id_ed25519_vast      # dedicated key (NOT the ferranti/galvani identity) — isolates/revokes independently
VAST_PROXY_JUMP=
VAST_CONTROL_PATH=~/.ssh/cm-vast-%r@%h:%p
VAST_REMOTE_PATH=/workspace/dreamerv4-tests   # one-time `git clone` bootstrap; sync_code.sh fetches/checks out from here after
VAST_PARTITION=                          # unused (no SLURM) — leave blank
VAST_ACCOUNT=                            # unused — leave blank
VAST_GRES=                               # unused — leave blank
VAST_CONSTRAINT=                         # unused — leave blank
VAST_DEFAULT_HOURS=                      # unused — vast_run.sh has no wall-clock cap; jobs self-terminate via their own --budget-s
VAST_MODULES=                            # unused — leave blank
VAST_VENV_ROOT=/workspace/venvs          # same venv-by-requirements-hash convention as ferranti/galvani
VAST_RUNS_SUBDIR=runs
